<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(ExtensionsVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Farmacorp.PosExpress.Datos\Farmacorp.PosExpress.Datos.csproj" />
        <ProjectReference Include="..\Farmacorp.PosExpress.Negocio\Farmacorp.PosExpress.Negocio.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Recursos\Textos.resx">
            <StronglyTypedFileName>$(IntermediateOutputPath)Textos.Designer.cs</StronglyTypedFileName>
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
            <StronglyTypedNamespace>Farmacorp.PosExpress.Presentacion.Recursos</StronglyTypedNamespace>
            <StronglyTypedClassName>Textos</StronglyTypedClassName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
