<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <handlers>
      <!-- Todas las rutas las atiende ApiHandler (equivale al ruteo de la API .NET 10) -->
      <add name="ApplicationDemo" path="*" verb="*" resourceType="Unspecified" preCondition="integratedMode"
           type="ApplicationDemo.NetFramework.ApiHandler, ApplicationDemo.NetFramework" />
    </handlers>
  </system.webServer>
</configuration>
